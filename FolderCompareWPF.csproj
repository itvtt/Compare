<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 릴리스 버전의 바닥값: Actions 러너는 마지막 릴리스의 다음 번호를 고름 (예전 i-luncher 버전 1.0.1 부터 이어감) -->
    <Version>1.0.1</Version>
    <ProjectGuid>{DD3A6778-5C83-4DDE-BDBB-128AF0BF85D6}</ProjectGuid>
    <ApplicationIcon>Assets\FolderCompare.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ILuncherIntegrated)' == 'true'">
    <OutputType>Library</OutputType>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup Condition="'$(ILuncherIntegrated)' == 'true'">
    <ApplicationDefinition Remove="App.xaml" />
    <Compile Remove="App.xaml.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\FolderCompare.ico" />
    <Resource Include="Assets\FolderCompare.png" />
    <Compile Remove="DemoData\DemoVerifier\**\*.cs" />
  </ItemGroup>

  <!-- i-luncher AppKit: 자체 업데이트(update.json)와 릴리스 zip -->
  <Import Project="AppKit\AppKit.targets" />
</Project>
